PORT=3001
NODE_ENV=development

# REQUIRED in production: a long random string, e.g. `openssl rand -hex 32`.
# The app refuses to start in production if this is missing or left as "change-me".
SESSION_SECRET=change-me-in-production

DB_PATH=./data/crewfest.db

# Directory for uploaded applicant photos (outside public/, never served statically).
# In Docker, point this at the same volume as DB_PATH, e.g. UPLOADS_DIR=/data/uploads.
UPLOADS_DIR=var/uploads

# Password for the crew capacity page (/crew). Leave unset to keep /crew closed.
CREW_PASSWORD=change-me

# Cookie "Secure" flag. Default: true in production, false otherwise.
# Set to false when serving over plain HTTP (e.g. Docker on http://host:3001),
# otherwise the login cookie is dropped and you get a login loop.
# Behind a TLS-terminating proxy: keep it true.
# COOKIE_SECURE=false

# On startup: creates the admin if it does not exist, or resets the password if it does.
# Remove both once the account is set up to prevent accidental resets.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
